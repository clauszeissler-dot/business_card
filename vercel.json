{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "functions": {
    "api/index.py": {
      "includeFiles": "{service,scripts,assets}/**",
      "maxDuration": 15
    }
  },
  "rewrites": [{ "source": "/api/(.*)", "destination": "/api/index" }],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Content-Security-Policy", "value": "default-src 'self'; img-src 'self' data: https://media.licdn.com; style-src 'self'; script-src 'self'; connect-src 'self'; form-action 'self' https://www.linkedin.com; frame-ancestors 'none'; base-uri 'none'" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000" }
      ]
    }
  ]
}
